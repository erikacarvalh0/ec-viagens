generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum TripTitle {
  VAN_COORDINATOR
  ORGANIZER
}

enum ChargeStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum Period {
  MORNING
  AFTERNOON
  EVENING
}

model User {
  id          String       @id @default(cuid())
  name        String
  email        String       @unique
  googleSubject String? @unique
  passwordHash String
  sessionVersion Int @default(0)
  city        String?
  state       String?
  whatsapp    String?      @unique
  paymentReminderConsentAt DateTime?
  memberships TripMember[]
  photos      Photo[]
  passwordResetTokens PasswordResetToken[]
  emailVerifiedAt DateTime?
  emailVerificationTokens EmailVerificationToken[]
}

model Trip {
  id           String        @id @default(cuid())
  name         String
  startsAt     DateTime?
  endsAt       DateTime?
  locationName String?
  address      String?
  mapUrl       String?
  createdAt    DateTime      @default(now())
  archivedAt   DateTime?
  memberships  TripMember[]
  invitations  Invitation[]
  paymentPlans PaymentPlan[]
  photos       Photo[]
}

model TripMember {
  id      String     @id @default(cuid())
  tripId  String
  userId  String
  role    MemberRole @default(MEMBER)
  trip    Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id])
  travel  TravelInfo?
  titles  MemberTitle[]
  charges Charge[]

  @@unique([tripId, userId])
}

model MemberTitle {
  id          String     @id @default(cuid())
  memberId    String
  title       TripTitle
  description String?
  member      TripMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, title])
}

model TravelInfo {
  id              String      @id @default(cuid())
  memberId        String      @unique
  outboundAt      DateTime?
  outboundPeriod  Period?
  outboundOrigin  String?
  returnAt        DateTime?
  returnPeriod    Period?
  returnOrigin    String?
  transportMode   String?
  needsRide       Boolean     @default(false)
  interestedVan   Boolean     @default(false)
  shareUber       Boolean     @default(false)
  offersRide      Boolean     @default(false)
  rideOutbound    Boolean     @default(false)
  rideReturn      Boolean     @default(false)
  member          TripMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Invitation {
  id        String           @id @default(cuid())
  tripId    String
  whatsapp  String
  tokenHash String           @unique
  expiresAt DateTime
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  trip      Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model PaymentPlan {
  id          String   @id @default(cuid())
  tripId      String
  name        String
  amountCents Int
  dueDay      Int?
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  charges     Charge[]
}

model Charge {
  id             String        @id @default(cuid())
  paymentPlanId  String
  memberId       String
  asaasPaymentId String?       @unique
  amountCents    Int
  dueAt          DateTime
  paidAt         DateTime?
  status         ChargeStatus  @default(PENDING)
  paymentUrl     String?
  plan           PaymentPlan   @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  member         TripMember    @relation(fields: [memberId], references: [id])
  events         PaymentEvent[]

  @@index([status, dueAt])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  chargeId        String
  externalEventId String   @unique
  eventType       String
  payload         Json
  charge          Charge   @relation(fields: [chargeId], references: [id], onDelete: Cascade)
}

model Photo {
  id           String   @id @default(cuid())
  tripId       String
  uploadedById String
  storageKey   String   @unique
  thumbnailKey String?  @unique
  caption      String?
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
}

model Notification {
  id                  String    @id @default(cuid())
  recipientWhatsapp   String
  kind                String
  referenceId         String
  scheduledFor        DateTime
  sentAt              DateTime?
  providerMessageId   String?
  processingStartedAt DateTime?
  status              String    @default("PENDING")

  @@unique([kind, referenceId, scheduledFor])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
